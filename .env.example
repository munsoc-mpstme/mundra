# Copy to .env and fill in. See config.py for the full Settings model.
#
#   cp .env.example .env
#
# NOTE: an EMPTY value is not the same as an absent one. pydantic-settings reads
# `DOCS_URL=` as the empty string, not as "unset", so leaving a key present but
# blank overrides the default in config.py rather than falling back to it.
# Omit the line entirely if you want the default.

# --- Required (no defaults in config.py; the app will not start without these) ---

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SMTP host. Email is sent through Brevo's SMTP relay; config.py defaults MAIL_SERVER to
# smtp-relay.brevo.com. For local development set this to `localhost`: the connection is
# only opened when an email is actually sent, so every route except /register and
# /forgot_password works fine without a real mail server.
MAIL_SERVER=

# Password for the Postgres database. Read by both docker-compose.yml (to create the
# database) and the app (to connect to it), so set it once, before the first
# `docker compose up`. Changing it later does not change the existing database.
# Not needed if you set DATABASE_URL (a managed host) instead.
POSTGRES_PASSWORD=

# Managed database (Supabase, Render, ...). When set, this single connection string is
# used instead of the POSTGRES_* parts, and the app connects over SSL automatically.
# For Supabase use the Session pooler string (Project > Connect), e.g.:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave blank for local development (docker-compose provides Postgres).
# DATABASE_URL=

# --- Optional (uncomment to override the defaults in config.py) ---

# Bootstrap admin, for hosts without a shell. ADMIN_EMAIL alone promotes that existing
# account to admin on every start. With ADMIN_PASSWORD too, the account is created if it
# does not exist. Set these in the host's environment settings, never in a committed file.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# POSTGRES_USER=mundra
# POSTGRES_DB=mundra
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Preferred on hosts that block outbound SMTP (e.g. Render): a Brevo HTTP API key
# (Brevo dashboard > SMTP & API > API Keys, starts with xkeysib-). When set, email is
# sent over HTTPS instead of SMTP and the MAIL_USERNAME/MAIL_PASSWORD below are not used.
# BREVO_API_KEY=xkeysib-...

# Brevo SMTP credentials (fallback used only when BREVO_API_KEY is empty). MAIL_USERNAME
# is the Brevo SMTP login (Brevo dashboard > SMTP & API > SMTP, e.g. 8xxxxxx@smtp-brevo.com),
# MAIL_PASSWORD is a generated SMTP key (NOT the account password), and MAIL_FROM must be a
# sender/domain verified in Brevo.
# MAIL_USERNAME=8xxxxxx@smtp-brevo.com
# MAIL_PASSWORD=
# MAIL_FROM=technology@munsocietympstme.com
# MAIL_FROM_NAME=Tech - MUNSociety MPSTME
# Port 587 uses STARTTLS (the default). For port 465, set MAIL_STARTTLS=false and
# MAIL_SSL_TLS=true.
# MAIL_PORT=587
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false

# Public base URL of the API, used to build password-reset links and the logo in emails.
# MUST be the public https address in production (https://mundra.onrender.com),
# otherwise reset links and the email logo point at localhost and do not work.
# URL=http://localhost:8000   (set for local development; the default is the deployed server)

# How long a password-reset link stays valid (minutes). It also stops working once used.
# PASSWORD_RESET_EXPIRE_MINUTES=30

# The conference's offset from UTC in minutes (330 = IST). Meal-scan days and the end of
# team access are worked out in this local time.
# EVENT_UTC_OFFSET_MINUTES=330

# TECH_EMAIL=technology@munsocietympstme.com
# SUPPORT_EMAIL=contact@munsocietympstme.com
# VERIFICATION_TOKEN_EXPIRE_MINUTES=120

# API documentation. Swagger is off by default; ReDoc is served at /docs.
# DOCS_URL=/swagger
# REDOC_URL=/docs
