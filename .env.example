# Copy to .env and fill in. See config.py for the full Settings model.
#
#   cp .env.example .env
#
# NOTE: an EMPTY value is not the same as an absent one. pydantic-settings reads
# `DOCS_URL=` as the empty string, not as "unset", so leaving a key present but
# blank overrides the default in config.py rather than falling back to it.
# Omit the line entirely if you want the default.

# --- Required (no defaults in config.py; the app will not start without these) ---

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SMTP host. For local development set this to `localhost`: the connection is only
# opened when an email is actually sent, so every route except /register and
# /forgot_password works fine without a real mail server.
MAIL_SERVER=

# --- Optional (uncomment to override the defaults in config.py) ---

# MAIL_USERNAME=technology@munsocietympstme.com
# MAIL_PASSWORD=
# MAIL_FROM=technology@munsocietympstme.com
# MAIL_FROM_NAME=Tech - MUNSociety MPSTME
# MAIL_PORT=465

# Public base URL, used to build verification and password-reset links.
# URL=http://localhost:8000

# TECH_EMAIL=technology@munsocietympstme.com
# SUPPORT_EMAIL=contact@munsocietympstme.com
# VERIFICATION_TOKEN_EXPIRE_MINUTES=120

# API documentation. Swagger is off by default; ReDoc is served at /docs.
# DOCS_URL=/swagger
# REDOC_URL=/docs
